{
	"cli": {
		"version": ">= 12.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"EXPO_PUBLIC_WEB_URL": "https://jejucleanhouse.com"
			}
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"EXPO_PUBLIC_WEB_URL": "https://jejucleanhouse.com"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_WEB_URL": "https://jejucleanhouse.com"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
